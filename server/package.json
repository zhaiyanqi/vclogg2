{
  "name": "vclogg-server",
  "version": "0.8.9",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "VCLogg portable filter server and embedded administration console",
  "scripts": {
    "dev:admin": "vite --config admin-web/vite.config.ts",
    "build:admin": "vite build --config admin-web/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p admin-web/tsconfig.json",
    "test": "go test ./...",
    "build": "node ../scripts/package-server-release.mjs",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "element-plus": "^2.11.1",
    "pinia": "^3.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.0.6"
  }
}
