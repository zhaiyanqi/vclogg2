-    /// Paint the selection background.
+    /// Selection rectangles use the same shaped layout as hit testing and copying.
+    fn selection_bounds(
+        selection: &Selection,
+        layout: &TextLayout,
+        bounds: &Bounds<Pixels>,
+    ) -> Vec<Bounds<Pixels>> {
+        let start = selection.start.min(selection.end);
+        let end = selection.start.max(selection.end);
+        let (Some(a), Some(b)) = (
+            layout.position_for_index(start),
+            layout.position_for_index(end),
+        ) else {
+            return Vec::new();
+        };
+        let height = layout.line_height();
+        if a.y == b.y {
+            return vec![Bounds::from_corners(a, point(b.x, b.y + height))];
+        }
+        let mut rectangles = vec![Bounds::from_corners(a, point(bounds.right(), a.y + height))];
+        if b.y > a.y + height {
+            rectangles.push(Bounds::from_corners(
+                point(bounds.left(), a.y + height),
+                point(bounds.right(), b.y),
+            ));
+        }
+        rectangles.push(Bounds::from_corners(
+            point(bounds.left(), b.y),
+            point(b.x, b.y + height),
+        ));
+        rectangles
+    }
